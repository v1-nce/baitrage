# Baitrage environment template
# Copy this file to .env.local and fill in the values you have.
# Do not commit .env.local.

# Gemini Flash Live monitoring stream
# This should be a WebSocket endpoint or your own short-lived-token proxy.
# Do not place a raw API key in this public browser variable.
# Example: wss://your-domain.com/api/gemini-live
NEXT_PUBLIC_GEMINI_LIVE_WS_URL=

# Gemini Pro pivot synthesis via Vercel AI SDK
# Required for AI-generated Optimised Prompt output.
# If empty, Baitrage uses a deterministic local fallback prompt.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# Cursor/local context bridge
# Baitrage reads this JSON file for active file context:
# { "path": "src/app/page.tsx", "language": "tsx", "content": "...", "cursor": { "line": 12, "column": 4 } }
BAITRAGE_CONTEXT_FILE=.cursor/baitrage-context.json

# Optional newline-delimited file list exported from Cursor indexing.
# If missing, Baitrage falls back to crawling the local source tree.
CURSOR_INDEX_FILE=.cursor/baitrage-indexed-files.txt
