# ─── Baitrage Environment ────────────────────────────────────────────
# Copy to .env.local and fill in. Do not commit .env.local.

# Required — powers both Observer (Flash) and Prompt Architect (Pro).
GOOGLE_GENERATIVE_AI_API_KEY=

# Model overrides (defaults shown)
GEMINI_FLASH_MODEL=gemini-2.0-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# Cursor/IDE context bridge
# Baitrage reads this JSON for active file context:
# { "path": "src/app/page.tsx", "language": "tsx", "content": "...", "cursor": { "line": 12 } }
BAITRAGE_CONTEXT_FILE=.cursor/baitrage-context.json

# Optional: newline-delimited file list from Cursor indexing.
# Falls back to crawling the local source tree if missing.
CURSOR_INDEX_FILE=.cursor/baitrage-indexed-files.txt
